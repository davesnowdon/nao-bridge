ARG LEGACY_IMAGE=davesnowdon/nao-bridge@sha256:792fc4c8b46b0645898494555d39460d654058a44a24b94592bfb4066283ee86
ARG MODERN_BASE=ubuntu:24.04@sha256:fe81560990fae86dc4743202b2cb4d3df98d0bcf949173cecef15ce1127ef852
FROM ${LEGACY_IMAGE} AS legacy
COPY collect_legacy.py /tmp/collect_legacy.py
RUN /usr/bin/python2.7 /tmp/collect_legacy.py

FROM ${MODERN_BASE} AS runtime
ARG MODERN_BASE
ENV PROBE_BASELINE=${MODERN_BASE}
COPY os-packages.lock /experiment/os-packages.lock
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive xargs -a /experiment/os-packages.lock \
       apt-get install -y --no-install-recommends \
    && dpkg-query -W '-f=${binary:Package}=${Version}\n' | LC_ALL=C sort > /tmp/resolved-packages \
    && diff -u /experiment/os-packages.lock /tmp/resolved-packages \
    && rm -rf /var/lib/apt/lists/*
COPY --from=legacy /bundle/ /
COPY artifacts/python.tar.gz /tmp/python.tar.gz
RUN echo '126343c54daff4068efc1ac269518d0cc202d57857794948103dd1454e8881be  /tmp/python.tar.gz' | sha256sum -c - \
    && mkdir -p /opt/modern \
    && tar -xzf /tmp/python.tar.gz -C /opt/modern --strip-components=1 \
    && rm /tmp/python.tar.gz
ENV PATH=/opt/modern/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LEGACY_PYTHON=/opt/legacy/bin/python2.7 \
    LEGACY_LIBRARY_PATH=/opt/legacy/sdk-sonames:/opt/legacy/lib
WORKDIR /experiment
ENTRYPOINT ["/opt/modern/bin/python3"]

FROM runtime AS experiment
COPY artifacts/wheels /wheels
COPY requirements.lock /experiment/requirements.lock
RUN python3 -m pip install --no-index --find-links=/wheels --require-hashes -r requirements.lock \
    && python3 -m pip check && rm -rf /wheels
COPY *.py /experiment/
USER ubuntu
CMD ["verify.py"]
