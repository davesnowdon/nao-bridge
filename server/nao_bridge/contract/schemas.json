          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/Session"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "robot.connection_changed"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/ConnectionChanged"
              }
            }
          }
        },
        {
